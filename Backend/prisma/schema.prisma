// Dinheiro está sendo armazenado como centavos totais, por enquanto

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  surname  String
  email    String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts   Account[]
}

model Account {
  id      Int    @id @default(autoincrement())
  userId  Int
  name    String
  type    String
  institution String? 
  color String
  amount Int
  active Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Transaction {
  id              Int      @id @default(autoincrement())
  accountId       Int
  category        String
  type            String
  amount          Int
  description     String
  transactionDate String
  paymentType     String?
  recurrentTransaction Boolean


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account  Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
}
